# MEPCO Portal — Server Environment Variables Template
# -------------------------------------------------------------------
# Copy this file to '.env' in the server directory and customize it.
# In Render/Koyeb, add these variables in your web service Environment settings.

# Port for the Node/Express server to listen on. Default is 5000.
PORT=5000

# MongoDB Connection String (Atlas Cloud URI or Local compass URI)
# Example Local: mongodb://localhost:27017/mepco
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/mepco
MONGO_URI=mongodb+srv://admin:password123@cluster0.mongodb.net/mepco

# Secret key used for signing and verifying JWT tokens (Use a secure random string)
JWT_SECRET=mepco_jwt_encryption_secret_key_2026

# GMail Account for Dispatching Provisioning Credentials (App Passwords required)
GMAIL_USER=your_gmail_username@gmail.com
GMAIL_PASS=your_gmail_app_password
