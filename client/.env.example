# MEPCO Portal — Client Environment Variables Template
# -------------------------------------------------------------------
# Copy this file to '.env' in the client directory and customize it.
# In Vercel, add this variable in Project Settings -> Environment Variables.

# URL of the hosted backend Express API server.
# In local development, leave it blank or set to: http://localhost:5000/api
# In production, set to your Render/Koyeb backend URL (e.g., https://mepco-api.onrender.com/api)
VITE_API_URL=http://localhost:5000/api
